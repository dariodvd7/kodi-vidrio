msgctxt "#30000"
msgid "General"
msgstr "General"

msgctxt "#30001"
msgid "Catalogue file"
msgstr "Archivo de catálogo"

msgctxt "#30002"
msgid "Play trailers in the background on Home"
msgstr "Reproducir el tráiler de fondo en el inicio"

msgctxt "#30003"
msgid "Seconds on an item before the trailer starts"
msgstr "Segundos sobre un título antes de que arranque el tráiler"

msgctxt "#30004"
msgid "Search Spanish subtitles automatically"
msgstr "Buscar subtítulos en español automáticamente"

msgctxt "#30005"
msgid "Show only the channels DGO has in the TV guide"
msgstr "Mostrar en la guía solo los canales de DGO"

msgctxt "#30006"
msgid "Back up this Kodi's settings to the home server every day"
msgstr "Hacer un backup diario de la configuración de este Kodi en el homelab"

msgctxt "#30007"
msgid "Backup folder (empty: KodiBackups on the home server)"
msgstr "Carpeta del backup (vacío: KodiBackups del homelab)"

msgctxt "#30008"
msgid "Restore a backup"
msgstr "Restaurar un backup"

msgctxt "#30009"
msgid "Catalogue source"
msgstr "Origen del catálogo"

msgctxt "#30010"
msgid "Home server (catalogo.json)"
msgstr "Homelab (catalogo.json)"

msgctxt "#30011"
msgid "Folders"
msgstr "Carpetas"

msgctxt "#30012"
msgid "Movies folder"
msgstr "Carpeta de películas"

msgctxt "#30013"
msgid "TV shows folder"
msgstr "Carpeta de series"

msgctxt "#30014"
msgid "TMDb key (optional: Spanish titles, plots and pictures)"
msgstr "Clave de TMDb (opcional: títulos, sinopsis e imágenes en español)"

msgctxt "#30015"
msgid "Update the catalogue now"
msgstr "Actualizar el catálogo ahora"

msgctxt "#30016"
msgid "Favourite teams (comma separated, e.g. Racing Club, Packers)"
msgstr "Equipos favoritos (separados por coma, por ejemplo Racing Club, Packers)"

msgctxt "#30017"
msgid "Remind me of my favourite teams’ matches"
msgstr "Avisarme los partidos de mis equipos favoritos"

msgctxt "#30018"
msgid "Offer the next episode when one ends (15-second countdown)"
msgstr "Ofrecer el siguiente episodio al terminar uno (cuenta de 15 segundos)"

msgctxt "#30019"
msgid "Pick the audio in the original language"
msgstr "Elegir el audio en el idioma original"
