<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vidrio: pantalla de serie al estilo de la app TV del Apple TV.
	La abre plugin.video.vidrio (?abrir_serie=) o el inicio, con la serie en Window(home).Property(Vidrio.SerieQ)
	(nombre de carpeta ya codificado para URL). Arriba la serie; abajo temporadas (píldoras) y episodios (tarjetas de
	vidrio). Elegir un episodio lo reproduce.
-->
<window id="1150" type="window">
	<defaultcontrol always="true">5202</defaultcontrol>
	<backgroundcolor>FF0A0A0E</backgroundcolor>
	<controls>
		<!-- Datos de la serie (lista invisible, fuera de pantalla) -->
		<control type="list" id="5200">
			<left>-3000</left><top>0</top><width>10</width><height>10</height>
			<itemlayout width="10" height="10"/>
			<focusedlayout width="10" height="10"/>
			<content>plugin://plugin.video.vidrio/?serie=$INFO[Window(home).Property(Vidrio.SerieQ)]&amp;info=1</content>
		</control>

		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true">$INFO[Container(5200).ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1500</width><height>1080</height>
			<texture>vidrio/fade_left.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>160</top><width>1920</width><height>440</height>
			<texture>vidrio/fade_bottom.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>598</top><width>1920</width><height>482</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>

		<!-- Encabezado de la serie -->
		<control type="group">
			<left>110</left><top>80</top>
			<control type="label">
				<width>1100</width><height>36</height>
				<font>vidrio_kicker</font><textcolor>B3FFFFFF</textcolor>
				<label>SERIE$INFO[Container(5200).ListItem.Rating,   ★ ,]</label>
			</control>
			<control type="label">
				<top>38</top><width>1300</width><height>100</height>
				<font>vidrio_hero</font><textcolor>FFFFFFFF</textcolor><shadowcolor>66000000</shadowcolor>
				<label>$INFO[Container(5200).ListItem.Label]</label>
			</control>
			<control type="label">
				<top>140</top><width>1300</width><height>40</height>
				<font>vidrio_meta</font><textcolor>D9FFFFFF</textcolor>
				<label>$INFO[Container(5200).ListItem.Property(vidrio.meta)]</label>
			</control>
			<control type="textbox">
				<top>190</top><width>1100</width><height>120</height>
				<font>vidrio_plot</font><textcolor>D9FFFFFF</textcolor>
				<label>$INFO[Container(5200).ListItem.Plot]</label>
			</control>
		</control>
		<control type="label">
			<right>80</right><top>48</top><width>300</width><height>52</height>
			<align>right</align><aligny>center</aligny>
			<font>vidrio_tab</font><textcolor>E6FFFFFF</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<!-- Temporadas: píldoras de vidrio -->
		<control type="list" id="5201">
			<left>100</left><top>420</top><width>1720</width><height>76</height>
			<orientation>horizontal</orientation>
			<scrolltime tween="cubic" easing="out">250</scrolltime>
			<ondown>5202</ondown>
			<onclick>SetFocus(5202)</onclick>
			<itemlayout width="270" height="76">
				<control type="image">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<texture border="32">vidrio/glass_pill.png</texture>
				</control>
				<control type="label">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<align>center</align><aligny>center</aligny>
					<font>vidrio_tab</font><textcolor>D9FFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="270" height="76">
				<control type="image">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<texture border="32">vidrio/pill_focus.png</texture>
					<visible>Control.HasFocus(5201)</visible>
				</control>
				<control type="image">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<texture border="32">vidrio/glass_panel_focus.png</texture>
					<visible>!Control.HasFocus(5201)</visible>
				</control>
				<control type="label">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<align>center</align><aligny>center</aligny>
					<font>vidrio_tab</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus(5201)</visible>
				</control>
				<control type="label">
					<left>6</left><top>6</top><width>250</width><height>64</height>
					<align>center</align><aligny>center</aligny>
					<font>vidrio_tab</font>
					<textcolor>FF101014</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(5201)</visible>
				</control>
			</focusedlayout>
			<content>plugin://plugin.video.vidrio/?serie=$INFO[Window(home).Property(Vidrio.SerieQ)]&amp;temporadas=1</content>
		</control>

		<!-- Episodios de la temporada elegida: tarjetas de vidrio -->
		<control type="label">
			<left>110</left><top>514</top><width>1200</width><height>40</height>
			<font>vidrio_row</font><textcolor>F2FFFFFF</textcolor>
			<label>$INFO[Container(5201).ListItem.Label]$INFO[Container(5201).ListItem.Property(vidrio.meta),  ·  ,]</label>
		</control>
		<control type="list" id="5202">
			<left>90</left><top>572</top><width>1830</width><height>500</height>
			<orientation>horizontal</orientation>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<onup>5201</onup>
			<itemlayout width="530" height="500">
				<control type="group">
					<left>16</left><top>22</top>
					<control type="image">
						<width>500</width><height>450</height>
						<texture border="30">vidrio/glass_panel.png</texture>
					</control>
					<include content="VidrioEpisodio"/>
				</control>
			</itemlayout>
			<focusedlayout width="530" height="500">
				<control type="group">
					<left>16</left><top>22</top>
					<animation effect="zoom" start="100" end="105" center="250,225" time="220" tween="cubic" easing="out" reversible="false" condition="Control.HasFocus(5202)">Conditional</animation>
					<control type="image">
						<width>500</width><height>450</height>
						<texture border="30">vidrio/glass_panel_focus.png</texture>
					</control>
					<control type="image">
						<width>500</width><height>450</height>
						<texture border="30">vidrio/card_focus_panel.png</texture>
						<visible>Control.HasFocus(5202)</visible>
					</control>
					<include content="VidrioEpisodio"/>
				</control>
			</focusedlayout>
			<content>plugin://plugin.video.vidrio/?serie=$INFO[Window(home).Property(Vidrio.SerieQ)]&amp;temporada=$INFO[Container(5201).ListItem.Property(vidrio.temporada)]</content>
		</control>
	</controls>
</window>
