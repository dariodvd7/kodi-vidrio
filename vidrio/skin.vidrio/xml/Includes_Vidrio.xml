		<definition>
			<control type="group">
				<height>350</height>
				<visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating</visible>
				<control type="label">
					<left>110</left><top>0</top><width>1200</width><height>44</height>
