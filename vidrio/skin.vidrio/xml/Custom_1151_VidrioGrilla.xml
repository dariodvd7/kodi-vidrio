<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vidrio: pantalla de Películas / Series al estilo de la app TV del Apple TV.
	Window(home).Property(Vidrio.GrillaQ) = lista=peliculas | lista=series | lista=trakt | genero=<codificado> (parámetros del add-on).
	Window(home).Property(Vidrio.GrillaTitulo) = título de la sección.
	Window(home).Property(Vidrio.GrillaOrden) = '' (A-Z) | reciente | anio | puntaje (píldoras de orden).
	Arriba el título enfocado (fanart difuminado, datos, sinopsis); abajo la grilla de pósters de vidrio.
-->
<window id="1151" type="window">
	<defaultcontrol always="true">5301</defaultcontrol>
	<backgroundcolor>FF0A0A0E</backgroundcolor>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true">$INFO[Container(5301).ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1500</width><height>1080</height>
			<texture>vidrio/fade_left.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>120</top><width>1920</width><height>360</height>
			<texture>vidrio/fade_bottom.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>478</top><width>1920</width><height>602</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>

		<!-- Encabezado: sección y título enfocado -->
		<control type="label">
			<left>110</left><top>44</top><width>800</width><height>60</height>
			<font>vidrio_row</font><textcolor>F2FFFFFF</textcolor>
			<label>$VAR[VidrioGrillaTitulo]$INFO[Container(5301).NumItems,  ·  ,]</label>
		</control>
		<control type="label">
			<right>80</right><top>48</top><width>300</width><height>52</height>
			<align>right</align><aligny>center</aligny>
			<font>vidrio_tab</font><textcolor>E6FFFFFF</textcolor>
			<label>$INFO[System.Time]</label>
		</control>
		<control type="group">
			<left>110</left><top>120</top>
			<control type="label">
				<width>1100</width><height>36</height>
				<font>vidrio_kicker</font><textcolor>B3FFFFFF</textcolor>
				<label>$INFO[Container(5301).ListItem.Property(vidrio.etiqueta)]$INFO[Container(5301).ListItem.Rating,   ★ ,]</label>
			</control>
			<control type="label">
				<top>36</top><width>1300</width><height>90</height>
				<font>vidrio_hero</font><textcolor>FFFFFFFF</textcolor><shadowcolor>66000000</shadowcolor>
				<label>$INFO[Container(5301).ListItem.Label]</label>
			</control>
			<control type="label">
				<top>128</top><width>1300</width><height>40</height>
				<font>vidrio_meta</font><textcolor>D9FFFFFF</textcolor>
				<label>$INFO[Container(5301).ListItem.Property(vidrio.meta)]</label>
			</control>
			<control type="textbox">
				<top>174</top><width>1100</width><height>80</height>
				<font>vidrio_plot</font><textcolor>CCFFFFFF</textcolor>
				<label>$INFO[Container(5301).ListItem.Plot]</label>
			</control>
		</control>

		<!-- Orden: píldoras de vidrio -->
		<control type="grouplist" id="5300">
			<left>104</left><top>400</top><width>1700</width><height>64</height>
			<orientation>horizontal</orientation>
			<itemgap>14</itemgap>
			<ondown>5301</ondown>
			<include content="VidrioOrden"><param name="id" value="5311"/><param name="label" value="A-Z"/><param name="orden" value=""/></include>
			<include content="VidrioOrden"><param name="id" value="5312"/><param name="label" value="Recientes"/><param name="orden" value="reciente"/></include>
			<include content="VidrioOrden"><param name="id" value="5313"/><param name="label" value="Año"/><param name="orden" value="anio"/></include>
			<include content="VidrioOrden"><param name="id" value="5314"/><param name="label" value="Puntaje"/><param name="orden" value="puntaje"/></include>
		</control>

		<!-- Grilla de pósters -->
		<control type="panel" id="5301">
			<left>90</left><top>478</top><width>1760</width><height>602</height>
			<orientation>vertical</orientation>
			<onup>5300</onup>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<onclick condition="String.IsEqual(ListItem.Property(vidrio.tipo),serie)">SetProperty(Vidrio.SerieQ,$INFO[ListItem.Property(vidrio.carpeta_q)],home)</onclick>
			<onclick condition="String.IsEqual(ListItem.Property(vidrio.tipo),serie)">ActivateWindow(1150)</onclick>
			<onclick condition="String.IsEqual(ListItem.Property(vidrio.continuar),1)">PlayMedia($ESCINFO[ListItem.FileNameAndPath])</onclick>
			<onclick condition="!String.IsEqual(ListItem.Property(vidrio.tipo),serie) + !String.IsEqual(ListItem.Property(vidrio.continuar),1)">Action(Info)</onclick>
			<itemlayout width="251" height="400">
				<control type="image">
					<left>18</left><top>24</top><width>216</width><height>324</height>
					<aspectratio>scale</aspectratio>
					<texture background="true" diffuse="vidrio/mask_poster.png" fallback="vidrio/white.png">$INFO[ListItem.Art(poster)]</texture>
				</control>
			</itemlayout>
			<focusedlayout width="251" height="400">
				<control type="group">
					<animation effect="zoom" start="100" end="108" center="126,186" time="200" tween="cubic" easing="out" reversible="false" condition="Control.HasFocus(5301)">Conditional</animation>
					<control type="image">
						<left>18</left><top>24</top><width>216</width><height>324</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="vidrio/mask_poster.png" fallback="vidrio/white.png">$INFO[ListItem.Art(poster)]</texture>
					</control>
					<control type="image">
						<left>18</left><top>24</top><width>216</width><height>324</height>
						<texture>vidrio/poster_focus.png</texture>
						<visible>Control.HasFocus(5301)</visible>
					</control>
				</control>
				<control type="label">
					<left>10</left><top>362</top><width>232</width><height>34</height>
					<align>center</align>
					<font>vidrio_small</font><textcolor>FFFFFFFF</textcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(5301)</visible>
				</control>
			</focusedlayout>
			<content>plugin://plugin.video.vidrio/?$INFO[Window(home).Property(Vidrio.GrillaQ)]&amp;orden=$INFO[Window(home).Property(Vidrio.GrillaOrden)]&amp;t=$INFO[Window(home).Property(Vidrio.Trakt)]</content>
		</control>
	</controls>
</window>
