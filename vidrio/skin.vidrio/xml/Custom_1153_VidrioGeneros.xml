<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vidrio: géneros al estilo de la app TV del Apple TV. Tarjetas de vidrio apaisadas con el fondo del título mejor
	puntuado de cada género, el nombre y la cantidad de títulos; los que más títulos tienen van primero.
	Elegir uno abre la grilla (1151) con las películas y series de ese género.
-->
<window id="1153" type="window">
	<defaultcontrol always="true">5501</defaultcontrol>
	<backgroundcolor>FF0A0A0E</backgroundcolor>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>500</fadetime>
			<texture background="true" colordiffuse="59FFFFFF">$INFO[Container(5501).ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="99000000">vidrio/white.png</texture>
		</control>

		<control type="label">
			<left>110</left><top>50</top><width>800</width><height>90</height>
			<font>vidrio_hero</font><textcolor>FFFFFFFF</textcolor>
			<label>Géneros</label>
		</control>
		<control type="label">
			<right>80</right><top>48</top><width>300</width><height>52</height>
			<align>right</align><aligny>center</aligny>
			<font>vidrio_tab</font><textcolor>E6FFFFFF</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<control type="panel" id="5501">
			<left>90</left><top>170</top><width>1760</width><height>910</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<onclick>SetProperty(Vidrio.GrillaQ,genero=$INFO[ListItem.Property(vidrio.genero_q)],home)</onclick>
			<onclick>SetProperty(Vidrio.GrillaTitulo,$INFO[ListItem.Label],home)</onclick>
			<onclick>ActivateWindow(1151)</onclick>
			<itemlayout width="440" height="270">
				<control type="group">
					<left>16</left><top>16</top>
					<control type="image">
						<width>408</width><height>230</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="vidrio/mask_card.png" fallback="vidrio/white.png" colordiffuse="CCFFFFFF">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="image">
						<width>408</width><height>230</height>
						<texture diffuse="vidrio/mask_card.png">vidrio/fade_bottom.png</texture>
					</control>
					<control type="image">
						<width>408</width><height>230</height>
						<texture border="30">vidrio/glass_nofo.png</texture>
					</control>
					<control type="label">
						<left>24</left><top>136</top><width>360</width><height>50</height>
						<font>vidrio_row</font><textcolor>FFFFFFFF</textcolor><shadowcolor>99000000</shadowcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>24</left><top>182</top><width>360</width><height>32</height>
						<font>vidrio_small</font><textcolor>BFFFFFFF</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</control>
			</itemlayout>
			<focusedlayout width="440" height="270">
				<control type="group">
					<left>16</left><top>16</top>
					<animation effect="zoom" start="100" end="107" center="204,115" time="200" tween="cubic" easing="out" reversible="false" condition="Control.HasFocus(5501)">Conditional</animation>
					<control type="image">
						<width>408</width><height>230</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="vidrio/mask_card.png" fallback="vidrio/white.png">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="image">
						<width>408</width><height>230</height>
						<texture diffuse="vidrio/mask_card.png">vidrio/fade_bottom.png</texture>
					</control>
					<control type="image">
						<width>408</width><height>230</height>
						<texture>vidrio/card_focus.png</texture>
						<visible>Control.HasFocus(5501)</visible>
					</control>
					<control type="label">
						<left>24</left><top>136</top><width>360</width><height>50</height>
						<font>vidrio_row</font><textcolor>FFFFFFFF</textcolor><shadowcolor>99000000</shadowcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>24</left><top>182</top><width>360</width><height>32</height>
						<font>vidrio_small</font><textcolor>E6FFFFFF</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</control>
			</focusedlayout>
			<content>plugin://plugin.video.vidrio/?lista=generos&amp;ventana=1</content>
		</control>
	</controls>
</window>
