<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vidrio: ficha de película/serie/episodio al estilo de la app TV del Apple TV.
	Tapa todo el inicio (fondo opaco), fanart de fondo difuminado hacia abajo y a la izquierda, datos a la izquierda,
	panel de vidrio con los detalles a la derecha y botones de vidrio. La original de Estuary está en
	herramientas/DialogVideoInfo.estuary.xml.orig.
	Ids que usa Kodi: 8 reproducir, 9 reanudar, 11 tráiler, 50 reparto.
-->
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

			<!-- Fondo opaco: el inicio no se ve detrás -->
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>1080</height>
				<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>1080</height>
				<aspectratio aligny="top">scale</aspectratio>
				<fadetime>400</fadetime>
				<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>1500</width><height>1080</height>
				<texture>vidrio/fade_left.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>240</top><width>1920</width><height>560</height>
				<texture>vidrio/fade_bottom.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>798</top><width>1920</width><height>282</height>
				<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
			</control>

			<!-- Datos -->
			<control type="group">
				<left>110</left><top>250</top>
				<control type="label">
					<width>1100</width><height>36</height>
					<font>vidrio_kicker</font>
					<textcolor>B3FFFFFF</textcolor>
					<label>$VAR[VidrioFichaKicker]</label>
				</control>
				<control type="label">
					<top>38</top><width>1180</width><height>100</height>
					<font>vidrio_hero</font>
					<textcolor>FFFFFFFF</textcolor>
					<shadowcolor>66000000</shadowcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<top>140</top><width>1180</width><height>40</height>
					<font>vidrio_meta</font>
					<textcolor>D9FFFFFF</textcolor>
					<label>$VAR[VidrioFichaMeta]</label>
				</control>
				<control type="label">
					<top>184</top><width>1100</width><height>36</height>
					<font>vidrio_plot</font>
					<textcolor>99FFFFFF</textcolor>
					<label>$INFO[ListItem.Tagline]</label>
					<visible>!String.IsEmpty(ListItem.Tagline)</visible>
				</control>
				<control type="textbox">
					<top>232</top><width>1040</width><height>234</height>
					<font>vidrio_plot</font>
					<textcolor>E6FFFFFF</textcolor>
					<autoscroll delay="8000" time="3000" repeat="10000">true</autoscroll>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</control>

			<!-- Panel de vidrio con detalles -->
			<control type="group">
				<left>1290</left><top>480</top>
				<visible>!String.IsEmpty(ListItem.Genre) | !String.IsEmpty(ListItem.Studio) | !String.IsEmpty(ListItem.OriginalTitle)</visible>
				<control type="image">
					<width>520</width><height>300</height>
					<texture border="30">vidrio/glass_panel.png</texture>
				</control>
				<control type="grouplist">
					<left>34</left><top>26</top><width>452</width><height>250</height>
					<orientation>vertical</orientation>
					<itemgap>8</itemgap>
					<include content="VidrioDato"><param name="nombre" value="Título original"/><param name="info" value="ListItem.OriginalTitle"/><param name="sufijo" value=""/></include>
					<include content="VidrioDato"><param name="nombre" value="Género"/><param name="info" value="ListItem.Genre"/><param name="sufijo" value=""/></include>
					<include content="VidrioDato"><param name="nombre" value="Duración"/><param name="info" value="ListItem.Property(vidrio.duracion)"/><param name="sufijo" value=""/></include>
					<include content="VidrioDato"><param name="nombre" value="Clasificación"/><param name="info" value="ListItem.Mpaa"/><param name="sufijo" value=""/></include>
					<include content="VidrioDato"><param name="nombre" value="Estudio"/><param name="info" value="ListItem.Studio"/><param name="sufijo" value=""/></include>
					<include content="VidrioDato"><param name="nombre" value="Director"/><param name="info" value="ListItem.Director"/><param name="sufijo" value=""/></include>
					
					
					
				</control>
			</control>

			<!-- Botones de vidrio -->
			<control type="grouplist" id="9000">
				<left>110</left><top>820</top><width>1700</width><height>80</height>
				<orientation>horizontal</orientation>
				<itemgap>24</itemgap>
				<ondown>50</ondown>
				<include content="VidrioBoton"><param name="id" value="8"/><param name="label" value="Reproducir"/><param name="visible" value="true"/></include>
				<include content="VidrioBoton"><param name="id" value="9"/><param name="label" value="$INFO[ListItem.PercentPlayed,Reanudar (,%)]"/><param name="visible" value="ListItem.IsResumable"/></include>
				<include content="VidrioBoton"><param name="id" value="11"/><param name="label" value="Ver tráiler"/><param name="visible" value="!String.IsEmpty(ListItem.Trailer)"/></include>
			</control>

			<!-- Reparto (solo si Kodi lo tiene) -->
			<control type="list" id="50">
				<left>100</left><top>930</top><width>1720</width><height>120</height>
				<orientation>horizontal</orientation>
				<onup>9000</onup>
				<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
				<itemlayout width="300" height="120">
					<control type="label">
						<left>10</left><top>10</top><width>280</width><height>36</height>
						<font>vidrio_small</font><textcolor>CCFFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>10</left><top>48</top><width>280</width><height>32</height>
						<font>vidrio_small</font><textcolor>80FFFFFF</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout width="300" height="120">
					<control type="image">
						<width>290</width><height>96</height>
						<texture border="30">vidrio/glass_panel_focus.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="label">
						<left>10</left><top>10</top><width>270</width><height>36</height>
						<font>vidrio_small</font><textcolor>FFFFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>10</left><top>48</top><width>270</width><height>32</height>
						<font>vidrio_small</font><textcolor>99FFFFFF</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
