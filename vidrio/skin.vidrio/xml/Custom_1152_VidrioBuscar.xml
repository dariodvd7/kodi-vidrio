<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vidrio: búsqueda al estilo de la app TV del Apple TV.
	Campo de vidrio arriba (5401); mientras está vacío muestra sugerencias (lo agregado últimamente); con texto,
	películas y series que coinciden (sin acentos ni mayúsculas, también por título original) en la grilla 5402.
-->
<window id="1152" type="window">
	<defaultcontrol always="true">5401</defaultcontrol>
	<backgroundcolor>FF0A0A0E</backgroundcolor>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true">$INFO[Container(5402).ListItem.Art(fanart)]</texture>
			<visible>Control.HasFocus(5402)</visible>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1500</width><height>1080</height>
			<texture>vidrio/fade_left.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>80</top><width>1920</width><height>356</height>
			<texture>vidrio/fade_bottom.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>434</top><width>1920</width><height>646</height>
			<texture colordiffuse="FF0A0A0E">vidrio/white.png</texture>
		</control>

		<control type="label">
			<left>110</left><top>44</top><width>800</width><height>60</height>
			<font>vidrio_row</font><textcolor>F2FFFFFF</textcolor>
			<label>Buscar</label>
		</control>
		<control type="label">
			<right>80</right><top>48</top><width>300</width><height>52</height>
			<align>right</align><aligny>center</aligny>
			<font>vidrio_tab</font><textcolor>E6FFFFFF</textcolor>
			<label>$INFO[System.Time]</label>
		</control>

		<!-- Campo de búsqueda de vidrio -->
		<control type="image">
			<left>104</left><top>112</top><width>1112</width><height>84</height>
			<texture border="40">vidrio/glass_pill.png</texture>
		</control>
		<control type="image">
			<left>140</left><top>136</top><width>36</width><height>36</height>
			<texture colordiffuse="B3FFFFFF">vidrio/lupa.png</texture>
		</control>
		<control type="edit" id="5401">
			<left>110</left><top>118</top><width>1100</width><height>72</height>
			<font>vidrio_meta</font>
			<textoffsetx>84</textoffsetx>
			<aligny>center</aligny>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FFFFFFFF</focusedcolor>
			<hinttext>Películas y series</hinttext>
			<texturefocus border="36" colordiffuse="40FFFFFF">vidrio/pill_focus.png</texturefocus>
			<texturenofocus/>
			<ondown>5402</ondown>
		</control>

		<!-- Datos del resultado enfocado -->
		<control type="group">
			<left>110</left><top>220</top>
			<visible>Control.HasFocus(5402)</visible>
			<control type="label">
				<width>1100</width><height>34</height>
				<font>vidrio_kicker</font><textcolor>B3FFFFFF</textcolor>
				<label>$INFO[Container(5402).ListItem.Property(vidrio.etiqueta)]$INFO[Container(5402).ListItem.Rating,   ★ ,]</label>
			</control>
			<control type="label">
				<top>30</top><width>1500</width><height>96</height>
				<font>vidrio_hero</font><textcolor>FFFFFFFF</textcolor><shadowcolor>66000000</shadowcolor>
				<label>$INFO[Container(5402).ListItem.Label]</label>
			</control>
			<control type="label">
				<top>128</top><width>1500</width><height>40</height>
				<font>vidrio_meta</font><textcolor>D9FFFFFF</textcolor>
				<label>$INFO[Container(5402).ListItem.Property(vidrio.meta)]</label>
			</control>
		</control>

		<control type="label">
			<left>110</left><top>394</top><width>1200</width><height>40</height>
			<font>vidrio_row</font><textcolor>F2FFFFFF</textcolor>
			<label>$VAR[VidrioBusquedaTitulo]</label>
		</control>

		<!-- Resultados -->
		<control type="panel" id="5402">
			<left>90</left><top>436</top><width>1760</width><height>644</height>
			<orientation>vertical</orientation>
			<onup>5401</onup>
			<scrolltime tween="cubic" easing="out">300</scrolltime>
			<preloaditems>2</preloaditems>
			<onclick condition="String.IsEqual(ListItem.Property(vidrio.tipo),serie)">SetProperty(Vidrio.SerieQ,$INFO[ListItem.Property(vidrio.carpeta_q)],home)</onclick>
			<onclick condition="String.IsEqual(ListItem.Property(vidrio.tipo),serie)">ActivateWindow(1150)</onclick>
			<onclick condition="!String.IsEqual(ListItem.Property(vidrio.tipo),serie)">Action(Info)</onclick>
			<itemlayout width="251" height="400">
				<control type="image">
					<left>18</left><top>24</top><width>216</width><height>324</height>
					<aspectratio>scale</aspectratio>
					<texture background="true" diffuse="vidrio/mask_poster.png" fallback="vidrio/white.png">$INFO[ListItem.Art(poster)]</texture>
				</control>
			</itemlayout>
			<focusedlayout width="251" height="400">
				<control type="group">
					<animation effect="zoom" start="100" end="108" center="126,186" time="200" tween="cubic" easing="out" reversible="false" condition="Control.HasFocus(5402)">Conditional</animation>
					<control type="image">
						<left>18</left><top>24</top><width>216</width><height>324</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="vidrio/mask_poster.png" fallback="vidrio/white.png">$INFO[ListItem.Art(poster)]</texture>
					</control>
					<control type="image">
						<left>18</left><top>24</top><width>216</width><height>324</height>
						<texture>vidrio/poster_focus.png</texture>
						<visible>Control.HasFocus(5402)</visible>
					</control>
				</control>
				<control type="label">
					<left>10</left><top>362</top><width>232</width><height>34</height>
					<align>center</align>
					<font>vidrio_small</font><textcolor>FFFFFFFF</textcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(5402)</visible>
				</control>
			</focusedlayout>
			<content>plugin://plugin.video.vidrio/?buscar=1&amp;ventana=1&amp;texto=$INFO[Control.GetLabel(5401).index(1)]</content>
		</control>
		<control type="label">
			<left>110</left><top>480</top><width>1400</width><height>40</height>
			<font>vidrio_meta</font><textcolor>99FFFFFF</textcolor>
			<label>Sin resultados para "$INFO[Control.GetLabel(5401).index(1)]"</label>
			<visible>!String.IsEmpty(Control.GetLabel(5401).index(1)) + Integer.IsEqual(Container(5402).NumItems,0) + !Container(5402).IsUpdating</visible>
		</control>
	</controls>
</window>
