<?xml version="1.0" encoding="utf-8"?>
<!--
	Vidrio: controles del reproductor al estilo del Apple TV. Panel de vidrio abajo con título, barra de avance,
	tiempos, idioma de audio y subtítulos en uso, y botones de vidrio:
	Pausa/Reproducir, -10 s, +10 s, Subtítulos, Audio, Buscar subtítulos, Más, Detener.
	La original de Estuary está en herramientas/VideoOSD.estuary.xml.orig.
-->
<window>
	<defaultcontrol always="true">7001</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<!-- Tocar arriba (fuera del panel) cierra los controles -->
		<control type="button">
			<left>0</left><top>0</top><width>1920</width><height>700</height>
			<texturefocus/><texturenofocus/>
			<onclick>Action(close)</onclick>
		</control>

		<control type="group">
			<visible>![Window.IsVisible(SliderDialog) | Window.IsVisible(1101) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(SubtitleSearch) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings) | Window.IsVisible(PVROSDChannels) | Window.IsVisible(pvrchannelguide)]</visible>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="250"/>
				<effect type="slide" start="0,80" end="0,0" time="250" tween="cubic" easing="out"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="200"/>
				<effect type="slide" start="0,0" end="0,80" time="200" tween="cubic" easing="in"/>
			</animation>
			<animation effect="fade" time="200">VisibleChange</animation>

			<!-- Sombra para leer sobre cualquier imagen -->
			<control type="image">
				<left>0</left><top>560</top><width>1920</width><height>520</height>
				<texture colordiffuse="E6FFFFFF">vidrio/fade_bottom.png</texture>
			</control>

			<!-- Título -->
			<control type="label">
				<left>110</left><top>684</top><width>1400</width><height>36</height>
				<font>vidrio_kicker</font><textcolor>B3FFFFFF</textcolor>
				<label>$VAR[VidrioOSDKicker]</label>
			</control>
			<control type="label">
				<left>110</left><top>720</top><width>1500</width><height>70</height>
				<font>vidrio_hero</font><textcolor>FFFFFFFF</textcolor><shadowcolor>66000000</shadowcolor>
				<label>$INFO[VideoPlayer.Title]</label>
			</control>

			<!-- Panel de vidrio -->
			<control type="image">
				<left>80</left><top>806</top><width>1760</width><height>234</height>
				<texture border="30">vidrio/glass_panel.png</texture>
			</control>

			<!-- Barra de avance -->
			<control type="group">
				<left>120</left><top>836</top>
				<visible>Player.SeekEnabled</visible>
				<control type="image">
					<width>1680</width><height>10</height>
					<texture border="5" colordiffuse="40FFFFFF">vidrio/pill_focus.png</texture>
				</control>
				<control type="progress">
					<width>1680</width><height>10</height>
					<texturebg/>
					<lefttexture/>
					<midtexture border="5" colordiffuse="FFFFFFFF">vidrio/pill_focus.png</midtexture>
					<righttexture/>
					<info>Player.Progress</info>
				</control>
				<control type="slider" id="87">
					<top>-12</top><width>1680</width><height>34</height>
					<texturesliderbar colordiffuse="00FFFFFF">vidrio/white.png</texturesliderbar>
					<textureslidernib colordiffuse="00FFFFFF">vidrio/white.png</textureslidernib>
					<textureslidernibfocus colordiffuse="00FFFFFF">vidrio/white.png</textureslidernibfocus>
					<info>Player.Progress</info>
					<action>seek</action>
					<ondown>7001</ondown>
					<onup>7001</onup>
				</control>
				<control type="label">
					<top>20</top><width>400</width><height>34</height>
					<font>vidrio_small</font><textcolor>D9FFFFFF</textcolor>
					<label>$INFO[Player.Time]</label>
				</control>
				<control type="label">
					<left>480</left><top>20</top><width>720</width><height>34</height>
					<align>center</align>
					<font>vidrio_small</font><textcolor>99FFFFFF</textcolor>
					<label>$INFO[Player.FinishTime,Termina a las ,]</label>
				</control>
				<control type="label">
					<left>1280</left><top>20</top><width>400</width><height>34</height>
					<align>right</align>
					<font>vidrio_small</font><textcolor>D9FFFFFF</textcolor>
					<label>$INFO[Player.TimeRemaining,-,]</label>
				</control>
			</control>

			<!-- Botones -->
			<control type="grouplist" id="7000">
				<left>110</left><top>906</top><width>1700</width><height>72</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<onup>87</onup>
				<include content="VidrioBotonOSD"><param name="id" value="7001"/><param name="label" value="$VAR[VidrioOSDPausa]"/><param name="accion" value="PlayerControl(Play)"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7002"/><param name="label" value="−10 s"/><param name="accion" value="Seek(-10)"/><param name="visible" value="Player.SeekEnabled"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7003"/><param name="label" value="+10 s"/><param name="accion" value="Seek(10)"/><param name="visible" value="Player.SeekEnabled"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7004"/><param name="label" value="Subtítulos"/><param name="accion" value="ActivateWindow(osdsubtitlesettings)"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7005"/><param name="label" value="Audio"/><param name="accion" value="ActivateWindow(osdaudiosettings)"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7006"/><param name="label" value="Buscar subtítulos"/><param name="accion" value="ActivateWindow(SubtitleSearch)"/><param name="visible" value="!VideoPlayer.Content(LiveTV)"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7007"/><param name="label" value="Siguiente"/><param name="accion" value="PlayerControl(Next)"/><param name="visible" value="VideoPlayer.HasNext"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7008"/><param name="label" value="Más"/><param name="accion" value="SetProperty(settingslist_content,osd,home)"/><param name="accion2" value="SetProperty(settingslist_header,$LOCALIZE[5],home)"/><param name="accion3" value="ActivateWindow(1101)"/></include>
				<include content="VidrioBotonOSD"><param name="id" value="7009"/><param name="label" value="Detener"/><param name="accion" value="PlayerControl(Stop)"/></include>
			</control>

			<!-- Audio y subtítulos en uso -->
			<control type="label">
				<left>110</left><top>990</top><width>1700</width><height>34</height>
				<font>vidrio_small</font><textcolor>99FFFFFF</textcolor>
				<label>$VAR[VidrioOSDPistas]</label>
			</control>
		</control>
	</controls>
</window>
